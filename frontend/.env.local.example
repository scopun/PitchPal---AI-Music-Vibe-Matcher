# Copy this file to .env.local for local development.
# .env.local is gitignored — do not commit it.

# Base URL of the FastAPI backend the frontend talks to.
# Local dev: point at the uvicorn server you run via `uvicorn app.main:app --reload`
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production (set this as a build-time env var in Render's static-site dashboard):
# VITE_API_BASE_URL=https://pitchpal-backend-0uyc.onrender.com

# NOTE: frontend/public/email-logo.png is served at /email-logo.png by Vite.
# The backend's EMAIL_LOGO_URL env var should point at this asset:
#   local dev  -> http://localhost:5173/email-logo.png   (Apple Mail only; Gmail can't reach localhost)
#   production -> https://pitchpal.co.uk/email-logo.png  (or whichever public frontend domain you deploy)
# If EMAIL_LOGO_URL is not set, the backend defaults to {FRONTEND_URL}/email-logo.png.
